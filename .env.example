# scout-logger — copy to .env and edit. Never commit .env.

# HTTP server
HOST=0.0.0.0
PORT=8080
PUBLIC_URL=http://localhost:8080
# Optional full-admin X-API-Key for scripts (e.g. ./dev seed). Leave empty to disable; if set, >= 32 random chars.
DASHBOARD_API_KEY=
DASHBOARD_WEB_PATH=scout/dashboard
# Extra origins allowed to call /api/* cross-origin (PUBLIC_URL's origin is always allowed). Comma-separated.
# CORS_ORIGINS=http://localhost:8081

# PostgreSQL (server reads POSTGRES_*; Docker dev maps DB_PORT to host)
POSTGRES_USER=scout
POSTGRES_PASSWORD=change-me
POSTGRES_DB=scout
DB_PORT=5433

# Deploy (./deploy) — optional
# HETZNER_HOST=root@your-server
# HETZNER_DIR=/opt/scout-logger
# HETZNER_SSH_KEY=~/.ssh/id_ed25519

# Auth (dashboard users)
# Required: >= 32 random chars (`openssl rand -hex 32`); must differ from ENCRYPTION_KEY.
JWT_SECRET=change-me-jwt-secret-min-32-chars
JWT_SESSION_TTL_DAYS=1
JWT_REMEMBER_TTL_DAYS=30
# Required: >= 32 random chars (`openssl rand -hex 32`); must differ from JWT_SECRET.
ENCRYPTION_KEY=change-me-encryption-key-min-32-chars
# Allow public signup. When false, only the first account (bootstrap admin) can sign up.
SIGNUP_ENABLED=false

# Email verification — NOT required. Leave SMTP empty and accounts are verified on signup.
# Only add these later if you want real verification emails:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com

# Telegram alerts — one bot for every project. Leave empty to hide the channel.
# Create the bot with @BotFather, then set the username without @.
# TELEGRAM_BOT_TOKEN=8618203691:AAFjcwkrPjni-_id6tFiWMPnzWn7jyiJNgo
# TELEGRAM_BOT_USERNAME=scout_logger_alert_bot
# Webhook secret Telegram sends back (A–Z, a–z, 0–9, _ and -). Required when PUBLIC_URL is https.
# TELEGRAM_WEBHOOK_SECRET=d5c0aeadd6d4ccd63b92bf9f92c4840f9c05be007a7980754eb7165738f6e9dc

# Mobile DSN is shown in the dashboard after you create a project — not stored here.
