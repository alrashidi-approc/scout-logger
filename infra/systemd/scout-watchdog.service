[Unit]
Description=Scout Logger host health watchdog
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/scout-logger
ExecStart=/bin/bash /opt/scout-logger/scripts/watchdog-scout.sh
# Containers started by `compose up -d` land in this cgroup; don't kill them on exit.
KillMode=process
Nice=10

[Install]
WantedBy=multi-user.target
